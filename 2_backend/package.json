{
    "name": "monolito",
    "version": "1.0.0",
    "description": "_Aplicación con un sistema de autenticación básico desarrollado con Node.js y Express, utilizando EJS como motor de plantillas y SQLite como base de datos._\r _Incluye gestión de sesiones mediante cookies, validación de usuarios y un sistema de roles (usuario / administrador) con zonas privadas protegidas según el rol._",
    "license": "MIT",
    "author": "Bryan",
    "type": "commonjs",
    "main": "index.js",
    "scripts": {
        "test": "npm run lint:fix && npm run format",
        "start": "node index.js",
        "dev": "nodemon index.js",
        "prepare": "husky",
        "lint:fix": "eslint . --ext .js --fix",
        "format": "prettier --write ."
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "better-sqlite3": "^12.4.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "ejs": "^3.1.10",
        "express": "^5.1.0",
        "nodemon": "^3.1.10",
        "pg": "^8.16.3",
        "picsum": "^1.1.5",
        "picsum-photos": "^3.0.10"
    },
    "devDependencies": {
        "@eslint/js": "^9.37.0",
        "eslint": "^9.37.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "globals": "^16.4.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.5",
        "prettier": "^3.6.2"
    }
}
